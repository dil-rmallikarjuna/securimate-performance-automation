# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# K6 PERFORMANCE TEST ENVIRONMENT VARIABLES
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 
# Note: k6 uses runtime environment variables via -e flag or export
# This file serves as documentation of available variables
#
# Usage: 
#   k6 run -e AUTH_TOKEN=your_token tests/api/test.js
#   export AUTH_TOKEN=your_token && npm run k6:smoke
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ═══════════════════════════════════════════════════════════════
# AUTHENTICATION (REQUIRED)
# ═══════════════════════════════════════════════════════════════
# Primary authentication token - pass via command line
AUTH_TOKEN=

# X-Ident header value for API requests
X_IDENT=k6-performance-test

# ═══════════════════════════════════════════════════════════════
# ENVIRONMENT SELECTION (Optional)
# ═══════════════════════════════════════════════════════════════
# Options: development | staging | production
ENVIRONMENT=development

# ═══════════════════════════════════════════════════════════════
# TEST CONFIGURATION (Optional)
# ═══════════════════════════════════════════════════════════════
# Load profile: smoke | load | stress | spike | soak | breakpoint
TEST_PROFILE=load

# ═══════════════════════════════════════════════════════════════
# TEST DATA REFERENCES (For WebSocket & Lookup Tests)
# ═══════════════════════════════════════════════════════════════
# Existing Third Party for reference tests
TP_ID=1280
TP_NUM=ZP3P-01734
TP_REFERENCE_ID=ZP3P-01395
COMPANY_NAME=ABC Carpet and Beverages

# AI Prompt for WebSocket tests
TEST_PROMPT=What are the key risk factors for this third party?

# ═══════════════════════════════════════════════════════════════
# WEBSOCKET CONFIGURATION (Optional)
# ═══════════════════════════════════════════════════════════════
# WebSocket server URL for Virtual Assistance
WS_URL=wss://rajathtpm-ai-websocket.highbond-s3.com/

# Token generation endpoint for WebSocket auth
TOKEN_ENDPOINT=https://dev3.steeleglobal.net/jwt-token/create
